[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "CORAtool"]
	path = CORAtool
	url = https://github.com/youngchanresearcher/coratool
[submodule "NSCA"]
	path = NSCA
	url = https://github.com/cran/NSCA
[submodule "SCAtools"]
	path = SCAtools
	url = https://github.com/cran/SCAtools
